# Front end (Cloudflare Pages -> Settings -> Variables and Secrets, also in a local .env for `npm run dev`)
VITE_SUPABASE_URL=https://asassxbdpykwydqbmpji.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key from the Clients Supabase project>

# Pages Functions (server side only - set as Secrets in Cloudflare, never in the front end)
SUPABASE_URL=https://asassxbdpykwydqbmpji.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
QBO_CLIENT_ID=<same Intuit production client id the other Abacus QuickBooks apps use>
QBO_CLIENT_SECRET=<same Intuit production client secret>
CRON_SECRET=<long random string, only needed for the daily refresh>

# Optional but recommended: a long random string that signs the "Connect a company" link,
# so that link no longer depends on the Supabase service key.
STATE_SECRET=<long random string>
